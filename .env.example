# Google AdSense configuration
#
# Ads are disabled by default. No publisher ID is included in this project.
# Leave these values empty until you are ready to enable advertising and have
# reviewed the consent, privacy, and policy requirements for your region.

NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional slot IDs for each placement. A placement renders only when ads are
# enabled, a client ID is set, and the relevant slot ID is present.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BELOW_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_CONVERTER_BELOW_CALCULATOR=
NEXT_PUBLIC_ADSENSE_SLOT_CONVERTER_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_CHART_BELOW_CONTENT=
